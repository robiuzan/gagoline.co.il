# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Editor / tooling backups — never commit. The pre-shim deployer lives in git history (796c4ce).
*.bak

# Rollback snapshot written by ops/deploy-site.ps1 — build output, never committed.
out.prev

# Earlier builds' /_next/static files, carried into each export — scripts/keep-previous-assets.mjs.
/.static-archive/

# Supplied 2026-08-27 but NOT publishable: 2 AI-generated, 3 stock, 1 carrying a third
# party's branding. Kept for reference, deliberately outside public/ so no build can ship
# them. History: assets/images/README.md.
/.rejected-photos/

# Page images (Media Studio/page-images). Candidates are staged here for review with
# IMAGES_DRAFT=1 and never enter git — only an installed, approved file under public/images/
# does (scripts/images/check-images-out.mjs prunes the folder from a production export).
/public/images/_candidates/

# Local copies of masters and review material for this PC; only the README is tracked.
/assets/images/*
!/assets/images/README.md
