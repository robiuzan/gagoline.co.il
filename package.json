  "private": true,
  "description": "גגוליין (Gagoline) — roof waterproofing service website. Hebrew, RTL, Next.js App Router.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
