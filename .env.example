# ── Gagoline environment template ──────────────────────────────────────────
# Copy to `.env.local` and fill real values. Never commit `.env.local`.
# Values marked 🔶 are assumptions from brief.md — confirm with client.

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="https://gagoline.co.il"

# Business contact (also mirrored in lib/site-config.ts)
NEXT_PUBLIC_PHONE="055-6601006"
NEXT_PUBLIC_WHATSAPP="972556601006"          # 🔶 confirm — assumed same as phone

# Analytics & tracking (brief Part H4) — leave blank to disable
NEXT_PUBLIC_GA_ID=""                          # 🔶 GA4 Measurement ID (G-XXXXXXXXXX)

# Lead routing (brief Part G1 / I6) — server-side only
LEAD_EMAIL_TO="info@gagoline.co.il"           # 🔶 confirm send-to address
# SMTP / email provider credentials (added when the contact form is wired up)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
